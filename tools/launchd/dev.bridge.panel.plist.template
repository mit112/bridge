<?xml version="1.0" encoding="UTF-8"?>
<!--
  REFERENCE TEMPLATE — NOT USED DIRECTLY.

  The real plist is generated by `bridge setup` with live-resolved paths
  (Python interpreter, working directory, PATH). This file documents the
  structure and the available keys.

  To regenerate:  bridge setup --launchd-only
  To uninstall:   bridge setup --uninstall
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.bridge.panel</string>

    <!-- The venv interpreter directly, not `uv run`: `uv run` re-resolves the
         environment on every start, which adds latency to a restart loop and
         can fail with no network. The venv holds an editable install pointing
         at this repo, so `-m bridge` picks up committed changes on restart. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/you/dev/bridge/.venv/bin/python</string>
        <string>-m</string>
        <string>bridge</string>
        <string>serve</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/you/dev/bridge</string>

    <!-- launchd hands out a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin).
         `launcher.resolve_claude` deliberately resolves `claude` through PATH
         rather than hardcoding it, so without ~/.local/bin here the panel
         serves fine but every session launch fails. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/you/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Start at login and keep it up: restart on crash, and on a clean exit
         too (a stray Ctrl-C or `kill` should not leave the panel down, since
         the Claude Code hooks POST to it). -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- If the port is already taken, uvicorn exits immediately; this bounds
         the retry loop to once every 10s instead of a hot spin. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Same file `bridge serve` was already being redirected into by hand.
         Both streams: uvicorn logs to stderr, tracebacks land beside them. -->
    <key>StandardOutPath</key>
    <string>/Users/you/.bridge/serve.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/you/.bridge/serve.log</string>
</dict>
</plist>
